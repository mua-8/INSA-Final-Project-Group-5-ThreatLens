# ThreatLens Endpoint Agent - Environment Variables Example
# Copy to .env for local development overrides (never commit actual secrets)

# Agent Configuration
THREATLENS_CONFIG_PATH=config/agent.example.yaml
THREATLENS_DATA_DIR=data
THREATLENS_LOG_LEVEL=INFO

# Backend Integration (Optional - not required for local development)
THREATLENS_BACKEND_URL=
THREATLENS_API_KEY=
THREATLENS_TLS_VERIFY=true
THREATLENS_CA_BUNDLE=
